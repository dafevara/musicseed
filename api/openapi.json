{
  "openapi": "3.1.0",
  "info": {
    "title": "MusicSeed API",
    "version": "0.1.0",
    "description": "REST API for MusicSeed — a personal, local-first music recommendation tool for Plex libraries. Every operation is available as a JSON endpoint. The Next.js web UI proxies `/api/*` to this server in development; standalone development runs on port 8789.",
    "license": { "name": "MIT" }
  },
  "servers": [
    { "url": "http://127.0.0.1:8789", "description": "Standalone API server (musicseed-api)" }
  ],
  "tags": [
    { "name": "discovery", "description": "Local environment probe — Plex server, databases, configuration" },
    { "name": "library", "description": "Library status, import, and synchronization" },
    { "name": "enrichment", "description": "Metadata enrichment from Spotify and ListenBrainz" },
    { "name": "recommend", "description": "Seed-based track recommendations with six scoring dimensions" },
    { "name": "sonic", "description": "Plex sonic analysis coverage inspection and refresh" },
    { "name": "dashboard", "description": "Aggregated snapshot — discovery, library stats, and job state" },
    { "name": "jobs", "description": "Long-running job progress and cancellation" }
  ],
  "paths": {
    "/discovery": {
      "get": {
        "tags": ["discovery"],
        "summary": "Run local discovery",
        "description": "Probe the local environment: MusicSeed database path, Plex library and blobs databases, Plex server reachability, authentication, and library existence. Accepts optional overrides for each field.",
        "operationId": "runDiscovery",
        "parameters": [
          { "name": "musicseed_db_path", "in": "query", "schema": { "type": "string" }, "description": "Override the MusicSeed database path" },
          { "name": "plex_db_path", "in": "query", "schema": { "type": "string" }, "description": "Override the Plex library database path" },
          { "name": "plex_url", "in": "query", "schema": { "type": "string" }, "description": "Override the Plex server URL" },
          { "name": "plex_token", "in": "query", "schema": { "type": "string" }, "description": "Override the Plex authentication token" },
          { "name": "plex_library", "in": "query", "schema": { "type": "string" }, "description": "Override the Plex music library name" }
        ],
        "responses": {
          "200": {
            "description": "Discovery result with per-check status and reason codes",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DiscoveryResponse" } } }
          }
        }
      }
    },
    "/discovery/check": {
      "post": {
        "tags": ["discovery"],
        "summary": "Re-run discovery with manual overrides",
        "description": "Accept user-provided values for any discovery field and re-run the probe. Blank fields keep their automatic values. Secret fields (token, client secret) are accepted but never returned in the response.",
        "operationId": "checkDiscovery",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": { "$ref": "#/components/schemas/DiscoveryOverrides" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Discovery result after applying overrides",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DiscoveryResponse" } } }
          }
        }
      }
    },
    "/discovery/init-db": {
      "post": {
        "tags": ["discovery"],
        "summary": "Initialize the MusicSeed database",
        "description": "Apply any path or credential overrides to the runtime configuration, then create (or validate) the MusicSeed SQLite database. Idempotent — safe to call on an existing database. Returns the discovery result after initialization.",
        "operationId": "initDatabase",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": { "$ref": "#/components/schemas/InitDbRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Discovery result after database initialization",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DiscoveryResponse" } } }
          }
        }
      }
    },
    "/library/status": {
      "get": {
        "tags": ["library"],
        "summary": "Get library status",
        "description": "Return library statistics (artist, album, track, play counts) and enrichment coverage per source (MBIDs, ListenBrainz, Spotify, sonic analysis).",
        "operationId": "getLibraryStatus",
        "responses": {
          "200": {
            "description": "Library status and coverage",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LibraryStatus" } } }
          }
        }
      }
    },
    "/library/import": {
      "post": {
        "tags": ["library"],
        "summary": "Start a library import job",
        "description": "Submit an asynchronous job to import metadata from the Plex library database into MusicSeed. Returns the job ID for progress tracking. Rejects the request if an import is already running.",
        "operationId": "startImport",
        "responses": {
          "200": {
            "description": "Job created",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JobCreated" } } }
          },
          "409": {
            "description": "An import job is already running",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/enrichment/spotify": {
      "post": {
        "tags": ["enrichment"],
        "summary": "Start Spotify enrichment",
        "description": "Save Spotify credentials (if provided), then submit an asynchronous job to enrich tracks with Spotify popularity data. Rejects the request if an enrichment job is already running.",
        "operationId": "startSpotifyEnrich",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": { "$ref": "#/components/schemas/SpotifyCredentials" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Job created",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JobCreated" } } }
          },
          "409": {
            "description": "An enrichment job is already running",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/recommend/typeahead": {
      "get": {
        "tags": ["recommend"],
        "summary": "Search tracks for autocomplete",
        "description": "Search the local library by track title or artist name. Returns up to 10 matches. Query must be at least 2 characters. Use `exclude` to omit already-selected seed IDs from results.",
        "operationId": "typeahead",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string", "minLength": 2 }, "description": "Search query (min 2 characters)" },
          { "name": "exclude", "in": "query", "schema": { "type": "string" }, "description": "Comma-separated track IDs to exclude" }
        ],
        "responses": {
          "200": {
            "description": "Matching tracks",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/TrackSuggestion" } } } }
          }
        }
      }
    },
    "/recommend": {
      "post": {
        "tags": ["recommend"],
        "summary": "Get recommendations from seed tracks",
        "description": "Run the full recommendation pipeline: resolve seed tracks by ID, build a candidate pool across six scoring dimensions (sonic, popularity, style, genre, era, novelty), score and rank every candidate, then return the top results with score breakdowns.",
        "operationId": "getRecommendations",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": { "$ref": "#/components/schemas/RecommendRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scored recommendations",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RecommendResponse" } } }
          }
        }
      }
    },
    "/sonic/status": {
      "get": {
        "tags": ["sonic"],
        "summary": "Get sonic analysis coverage",
        "description": "Report Plex sonic analysis coverage for the configured music library. Fetches every track over the Plex HTTP API, so it can be slow on large libraries. The `recent_days` parameter scopes the 'recent additions' window.",
        "operationId": "getSonicStatus",
        "parameters": [
          { "name": "library_name", "in": "query", "schema": { "type": "string" }, "description": "Plex music library name (uses configured default if omitted)" },
          { "name": "recent_days", "in": "query", "schema": { "type": "integer", "default": 7 }, "description": "Days to consider as 'recent additions'" }
        ],
        "responses": {
          "200": {
            "description": "Sonic analysis coverage",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SonicStatus" } } }
          }
        }
      }
    },
    "/sonic/refresh": {
      "post": {
        "tags": ["sonic"],
        "summary": "Trigger sonic analysis refresh",
        "description": "Trigger the Plex MusicAnalysis Butler task and watch a date-scoped window of recently added tracks until they are analyzed or the wait budget runs out. The Butler task always processes Plex's entire pending backlog — the date window only scopes what this call watches and reports.",
        "operationId": "refreshSonic",
        "parameters": [
          { "name": "library_name", "in": "query", "schema": { "type": "string" }, "description": "Plex music library name" },
          { "name": "days", "in": "query", "schema": { "type": "integer", "default": 7 }, "description": "Window of recently added music to watch" }
        ],
        "responses": {
          "200": {
            "description": "Refresh result with before/after pending counts",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SonicRefreshResult" } } }
          }
        }
      }
    },
    "/dashboard": {
      "get": {
        "tags": ["dashboard"],
        "summary": "Get the aggregated dashboard snapshot",
        "description": "Return a combined snapshot of discovery results, library statistics, active jobs, recent jobs, and the last successful sync — everything the dashboard screen needs in one call.",
        "operationId": "getDashboard",
        "responses": {
          "200": {
            "description": "Dashboard snapshot",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DashboardSnapshot" } } }
          }
        }
      }
    },
    "/jobs/{job_id}": {
      "get": {
        "tags": ["jobs"],
        "summary": "Get job progress",
        "description": "Return the current state, progress counters, and checkpoint message for a job. Poll this to track import, enrichment, or sonic refresh progress.",
        "operationId": "getJob",
        "parameters": [
          { "name": "job_id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "Job ID returned by the create/start endpoint" }
        ],
        "responses": {
          "200": {
            "description": "Job state",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Job" } } }
          },
          "404": {
            "description": "Job not found",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      },
      "parameters": [
        { "name": "job_id", "in": "path", "required": true, "schema": { "type": "integer" } }
      ]
    },
    "/jobs/{job_id}/cancel": {
      "post": {
        "tags": ["jobs"],
        "summary": "Cancel a running job",
        "description": "Request cooperative cancellation of a running job. The job will stop at its next checkpoint. Already-completed or already-canceled jobs are unaffected.",
        "operationId": "cancelJob",
        "parameters": [
          { "name": "job_id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "Job ID" }
        ],
        "responses": {
          "200": {
            "description": "Job state after cancellation request",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Job" } } }
          },
          "404": {
            "description": "Job not found",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DiscoveryResponse": {
        "type": "object",
        "description": "Result of a local environment probe.",
        "properties": {
          "ready": { "type": "boolean", "description": "True when every prerequisite for database creation is met" },
          "result": { "$ref": "#/components/schemas/DiscoveryResult" }
        }
      },
      "DiscoveryResult": {
        "type": "object",
        "description": "Per-component discovery checks with machine-readable reason codes.",
        "properties": {
          "musicseed_db": { "$ref": "#/components/schemas/DatabasePathCheck" },
          "plex_library_db": { "$ref": "#/components/schemas/FileCheck" },
          "plex_blobs_db": { "$ref": "#/components/schemas/FileCheck" },
          "plex_server": { "$ref": "#/components/schemas/PlexServerCheck" },
          "ready": { "type": "boolean" }
        }
      },
      "DatabasePathCheck": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "source": { "type": "string" },
          "exists": { "type": "boolean" },
          "writable": { "type": "boolean" },
          "creatable": { "type": "boolean" },
          "reason": { "type": "string", "description": "Machine-readable reason code: ok, parent_missing, not_writable, not_a_file, parent_not_writable" },
          "detail": { "type": "string", "description": "Human-readable detail when not ok" },
          "ok": { "type": "boolean" }
        }
      },
      "FileCheck": {
        "type": "object",
        "properties": {
          "candidates": { "type": "array", "items": { "$ref": "#/components/schemas/PathCandidate" } },
          "selected": { "$ref": "#/components/schemas/PathCandidate" },
          "ok": { "type": "boolean" }
        }
      },
      "PathCandidate": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "source": { "type": "string" },
          "exists": { "type": "boolean" },
          "usable": { "type": "boolean" },
          "reason": { "type": "string" },
          "detail": { "type": "string" }
        }
      },
      "PlexServerCheck": {
        "type": "object",
        "properties": {
          "url": { "type": "string" },
          "source": { "type": "string" },
          "token_configured": { "type": "boolean" },
          "server_version": { "type": "string" },
          "library": { "type": "string" },
          "library_found": { "type": "boolean" },
          "reason": { "type": "string", "description": "Machine-readable reason code: ok, unreachable, missing_token, unauthorized, library_not_found" },
          "detail": { "type": "string" },
          "ok": { "type": "boolean" }
        }
      },
      "DiscoveryOverrides": {
        "type": "object",
        "properties": {
          "musicseed_db_path": { "type": "string" },
          "plex_db_path": { "type": "string" },
          "plex_url": { "type": "string" },
          "plex_token": { "type": "string", "description": "Never returned in responses" },
          "plex_library": { "type": "string" }
        }
      },
      "InitDbRequest": {
        "type": "object",
        "properties": {
          "musicseed_db_path": { "type": "string", "description": "Optional override for the MusicSeed database path" },
          "spotify_client_id": { "type": "string", "description": "Optional Spotify client ID to persist" },
          "spotify_client_secret": { "type": "string", "description": "Optional Spotify client secret (never returned)" }
        }
      },
      "LibraryStatus": {
        "type": "object",
        "description": "Library statistics and enrichment coverage.",
        "properties": {
          "db_path": { "type": "string" },
          "db_size_bytes": { "type": "integer" },
          "plex_url": { "type": "string" },
          "plex_db": { "type": "string" },
          "plex_library": { "type": "string" },
          "artist_count": { "type": "integer" },
          "album_count": { "type": "integer" },
          "track_count": { "type": "integer" },
          "play_count": { "type": "integer" },
          "genre_count": { "type": "integer" },
          "mood_count": { "type": "integer" },
          "style_count": { "type": "integer" },
          "enrichment": { "$ref": "#/components/schemas/EnrichmentCoverage" }
        }
      },
      "EnrichmentCoverage": {
        "type": "object",
        "description": "Per-source enrichment coverage counts.",
        "properties": {
          "tracks_with_mbid": { "type": "integer", "description": "Tracks that have a MusicBrainz recording ID" },
          "tracks_with_spotify": { "type": "integer", "description": "Tracks matched to a Spotify ID" },
          "spotify_attempted": { "type": "integer", "description": "Tracks where Spotify matching was attempted" },
          "tracks_with_sonic": { "type": "integer", "description": "Tracks with Plex sonic analysis vectors available" },
          "tracks_with_listenbrainz": { "type": "integer", "description": "Tracks enriched with ListenBrainz popularity" },
          "listenbrainz_attempted": { "type": "integer", "description": "Tracks where ListenBrainz lookup was attempted" }
        }
      },
      "SpotifyCredentials": {
        "type": "object",
        "properties": {
          "spotify_client_id": { "type": "string", "description": "Spotify client ID (persisted to config)" },
          "spotify_client_secret": { "type": "string", "description": "Spotify client secret (persisted, never returned)" }
        }
      },
      "TrackSuggestion": {
        "type": "object",
        "description": "A track matching a typeahead search query.",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "artist": { "type": "string" }
        }
      },
      "RecommendRequest": {
        "type": "object",
        "required": ["seed_ids"],
        "properties": {
          "seed_ids": { "type": "string", "description": "Comma-separated track IDs to use as recommendation seeds" },
          "limit": { "type": "integer", "default": 50, "description": "Maximum number of recommendations to return" },
          "year_min": { "type": "string", "description": "Earliest release year filter (inclusive)" },
          "year_max": { "type": "string", "description": "Latest release year filter (inclusive)" },
          "max_tracks_per_artist": { "type": "integer", "default": 3, "description": "Maximum tracks per artist in results" },
          "min_score": { "type": "string", "description": "Minimum total score threshold (0.0–1.0)" }
        }
      },
      "RecommendResponse": {
        "type": "object",
        "properties": {
          "seed_track_ids": { "type": "array", "items": { "type": "integer" }, "description": "IDs of the resolved seed tracks" },
          "recommendations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Recommendation" }
          }
        }
      },
      "Recommendation": {
        "type": "object",
        "properties": {
          "track_id": { "type": "integer" },
          "title": { "type": "string" },
          "artist": { "type": "string" },
          "score": { "type": "number", "description": "Total score (0.0–1.0) across all six dimensions" }
        }
      },
      "SonicStatus": {
        "type": "object",
        "description": "Plex sonic analysis coverage for a music library.",
        "properties": {
          "library_name": { "type": "string" },
          "section_id": { "type": "string" },
          "total_tracks": { "type": "integer" },
          "analyzed_tracks": { "type": "integer" },
          "unanalyzed_tracks": { "type": "integer" },
          "recent_days": { "type": "integer" },
          "recent_tracks": { "type": "integer" },
          "recent_analyzed_tracks": { "type": "integer" },
          "recent_unanalyzed_tracks": { "type": "integer" },
          "unanalyzed_albums": { "type": "array", "items": { "$ref": "#/components/schemas/UnanalyzedAlbum" } }
        }
      },
      "UnanalyzedAlbum": {
        "type": "object",
        "properties": {
          "rating_key": { "type": "string" },
          "title": { "type": "string" },
          "artist": { "type": "string" },
          "track_count": { "type": "integer" },
          "unanalyzed_count": { "type": "integer" },
          "most_recent_added_at": { "type": "string", "format": "date-time" }
        }
      },
      "SonicRefreshResult": {
        "type": "object",
        "description": "Outcome of a sonic analysis refresh.",
        "properties": {
          "library_name": { "type": "string" },
          "days": { "type": "integer" },
          "pending_tracks_before": { "type": "integer" },
          "pending_tracks_after": { "type": "integer" },
          "analyzed_delta": { "type": "integer", "description": "Tracks analyzed during this refresh" },
          "pending_albums_before": { "type": "array", "items": { "$ref": "#/components/schemas/UnanalyzedAlbum" } },
          "still_pending_albums": { "type": "array", "items": { "$ref": "#/components/schemas/UnanalyzedAlbum" } },
          "activities_observed": { "type": "array", "items": { "type": "string" } },
          "waited_seconds": { "type": "number" },
          "stall_detected": { "type": "boolean", "description": "True if no progress was observed across consecutive polls" },
          "completed": { "type": "boolean" }
        }
      },
      "DashboardSnapshot": {
        "type": "object",
        "description": "Aggregated dashboard snapshot — discovery, library, active jobs, and recent activity.",
        "properties": {
          "discovery": { "$ref": "#/components/schemas/DiscoveryResult" },
          "library": { "$ref": "#/components/schemas/LibraryStatus" },
          "active_jobs": { "type": "array", "items": { "$ref": "#/components/schemas/Job" } },
          "recent_jobs": { "type": "array", "items": { "$ref": "#/components/schemas/Job" } },
          "last_sync": { "$ref": "#/components/schemas/Job" },
          "ready_for_recommendations": { "type": "boolean" }
        }
      },
      "Job": {
        "type": "object",
        "description": "State of an asynchronous MusicSeed job (import, enrichment, sonic refresh).",
        "properties": {
          "id": { "type": "integer" },
          "kind": { "type": "string", "description": "Job kind: import, enrich" },
          "state": { "type": "string", "description": "Job state: pending, running, succeeded, failed, canceled, cancel_requested, interrupted" },
          "progress_current": { "type": "integer" },
          "progress_total": { "type": "integer" },
          "checkpoint": { "type": "string", "description": "Human-readable checkpoint message" },
          "error_summary": { "type": "string", "description": "Error message when state is failed" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "started_at": { "type": "string", "format": "date-time" },
          "completed_at": { "type": "string", "format": "date-time" }
        }
      },
      "JobCreated": {
        "type": "object",
        "properties": {
          "job_id": { "type": "integer", "description": "The created job ID — poll /jobs/{job_id} for progress" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "description": "Human-readable error message" }
        }
      }
    }
  }
}
